[7.366, "o", "\u001b[1;34mAgent Action\u001b[0m \u001b[34m───────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n\u001b[1;36mSummary: \u001b[0mExercise duplicate scoring and game turn behavior\r\n\r\n\u001b[1;90mThought:\u001b[0m\r\nThe suite passes and EOF exits cleanly; I’ll exercise duplicate handling and turn-count behavior \r\ndirectly.\r\n\r\n\u001b[1;32m$ \u001b[0m\u001b[37mpython - <<'PY'\u001b[0m\r\n\u001b[37mfrom contextlib import redirect_stdout\u001b[0m\r\n\u001b[37mfrom io import StringIO\u001b[0m\r\n\u001b[37mfrom unittest.mock import patch\u001b[0m\r\n\r\n\u001b[37mfrom wordle import play_game\u001b[0m\r\n\u001b[37mfrom wordle_logic import score_guess\u001b[0m\r\n\r\n\u001b[37massert score_guess('SPEED', 'ABIDE') == ['absent', 'absent', 'present', 'absent', 'present']\u001b[0m\r\n\u001b[37massert score_guess('ALLEY', 'LLAMA') == ['present', 'correct', 'present', 'absent', 'absent']\u001b[0m\r\n\r\n\u001b[37mwith patch('builtins.input', side_effect=['no', 'c"]
